# 复制本文件为 docs/.env 并按需填写，例如：
#   VITE_ARTALK_SERVER=https://comments.example.com
#   VITE_ARTALK_SITE=GoCampus
#
# VITE_ARTALK_SERVER：Artalk 服务端地址。未配置时评论组件不初始化（站点其余功能不受影响）。
# VITE_ARTALK_SITE：站点名，必须与 Artalk 后台「设置 → 站点」中创建的站点名完全一致（区分大小写）。默认 GoCampus。
VITE_ARTALK_SERVER=https://artalk.xxx.com
VITE_ARTALK_SITE=GoCampus

# ---------------------------------------------------------------------------
# 划线批注 SDK（annotation-service/）
# ---------------------------------------------------------------------------
# VITE_ANNOTATION_API：批注服务地址，例如 https://annot.example.com
# VITE_ANNOTATION_SITE_KEY：在服务端用 CLI 创建站点后得到，例如：
#   annotation-service admin site create --name gocampus --origin https://你的博客域名
# 任一未配置时不会加载 SDK（阅读、Artalk 评论不受影响）。
VITE_ANNOTATION_API=https://annot.example.com
VITE_ANNOTATION_SITE_KEY=REPLACE_WITH_SITE_KEY
